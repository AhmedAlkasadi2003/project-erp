# ==============================================================================
# BACKEND ENVIRONMENT CONFIGURATION EXAMPLE
# ==============================================================================
# Copy this file to .env for local backend development:
#   cp .env.example .env
#
# DO NOT COMMIT REAL CREDENTIALS OR PRODUCTION SECRETS TO GIT.
# ==============================================================================

PORT=4000
NODE_ENV=development
DATABASE_URL="postgresql://erp_user:erp_password_local_dev@localhost:5434/inventory_erp_dev?schema=public"
CORS_ORIGIN="http://localhost:5173"

# JWT Authentication
JWT_SECRET="replace_with_a_secure_random_jwt_secret_key_minimum_32_characters"
JWT_EXPIRES_IN="1h"
