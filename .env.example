# ==============================================================================
# INVENTORY RECEIPTS ERP - ROOT ENVIRONMENT CONFIGURATION EXAMPLE
# ==============================================================================
# Copy this file to .env for local Docker Compose orchestration:
#   cp .env.example .env
#
# DO NOT COMMIT REAL SECRETS OR PRODUCTION PASSWORDS TO GIT.
# ==============================================================================

# PostgreSQL Container Configuration
POSTGRES_USER=erp_user
POSTGRES_PASSWORD=erp_password_local_dev
POSTGRES_DB=inventory_erp_dev
POSTGRES_PORT=5434

# Backend Service
BACKEND_PORT=4000
NODE_ENV=development

# JWT Security
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_minimum_32_characters
JWT_EXPIRES_IN=1h

# Frontend Service
VITE_PORT=5173
VITE_API_BASE_URL=http://localhost:4000/api/v1
