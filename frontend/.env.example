# ==============================================================================
# FRONTEND ENVIRONMENT CONFIGURATION EXAMPLE
# ==============================================================================
# Copy this file to .env for local frontend development:
#   cp .env.example .env
#
# DO NOT COMMIT REAL CREDENTIALS OR SERVER SECRETS TO FRONTEND ENVIRONMENT.
# Vite exposes variables prefixed with VITE_ to the browser client.
# ==============================================================================

VITE_PORT=5173
VITE_API_BASE_URL=http://localhost:4000/api/v1
